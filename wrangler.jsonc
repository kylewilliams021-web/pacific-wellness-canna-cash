{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacific-wellness-canna-cash",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "_worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "RATELIMIT_KV", "id": "ab5081366ba54dcab495351c3c06052e" }
  ],
  "observability": {
    "enabled": true
  }
}
